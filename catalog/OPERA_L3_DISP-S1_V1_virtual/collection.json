  "auth:schemes": {
    "edl-s3-asf": {
      "type": "s3",
      "description": "Earthdata Login: temporary S3 credentials from https://sentinel1.asf.alaska.edu/s3credentials. Valid only for in-region (us-west-2) access."
    },
    "edl-bearer": {
      "type": "http",
      "scheme": "bearer",
      "description": "Earthdata Login user token from https://urs.earthdata.nasa.gov, sent as 'Authorization: Bearer <token>' to the DAAC TEA HTTPS endpoint. Works from any region."
    }
  },
  "item_assets": {
